# Web application OAuth client ID from Google Cloud Console.
# Enable Google Sheets API and Google Drive API in the same project.
# Add http://localhost:5173 to Authorized JavaScript origins.
# No client secret is used. Login, creating sheets and selecting app-accessible
# files do not need an API key.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Optional: browse all of your Sheets using Google Picker, while keeping drive.file.
# Enable Google Picker API in the SAME project. Use a browser API key restricted
# to Google Picker API and Google Drive API, with your app origins and
# https://docs.google.com/* allowed as website referrers.
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_PROJECT_NUMBER=
